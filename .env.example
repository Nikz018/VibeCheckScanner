# Copy to .env. Never commit .env. Each line says who reads the variable.
# Production Compose rewrites DATABASE_URL and REDIS_URL to the internal
# hostnames, and forces ALLOW_LOCAL_TARGETS=false and DEV_EXPOSE_MAGIC_LINK=false.
# NEXT_PUBLIC_* values are baked into the web image at build time. After you
# change one, run bash scripts/deploy.sh so the image rebuilds.

# --- Process ---
# Set by the production images. Leave this as production on a server.
NODE_ENV=production

# --- Public URL (web and worker) ---
# Web uses APP_URL for magic links, checkout return URLs, and the session cookie.
# Worker uses it for links inside alert email. No trailing slash.
APP_URL=http://localhost:3000
# Web. Public origin for canonical URLs, sitemap, robots, Open Graph, JSON-LD, and llms.txt.
# Must match APP_URL in production. No trailing slash. Example: https://scan.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sign-in (web) ---
# Secret used to hash session cookies. At least 32 characters.
# Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
# Web. Show the magic link on the login screen when SMTP is not set.
# Keep true only on your laptop. Production Compose forces this to false.
DEV_EXPOSE_MAGIC_LINK=true

# --- Scan targets (web and worker) ---
# Allow scans of localhost / 127.0.0.1. Required for local demo targets.
# Keep false on any server. Production Compose forces false.
ALLOW_LOCAL_TARGETS=true
# Web and worker. Inside local Docker, rewrite localhost to the host gateway
# so containers can reach demo ports. Leave empty on a server and when you
# run npm scripts directly on the host.
LOCALHOST_REWRITE_HOST=

# --- Data (web and worker) ---
# On your laptop these point at local Postgres and Redis.
# On a server, use the hostnames postgres and redis. Compose builds DATABASE_URL
# from POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB below.
DATABASE_URL=postgresql://vibecheck:vibecheck@localhost:5432/vibecheck
REDIS_URL=redis://localhost:6379

# --- Production database (Compose only) ---
# POSTGRES_PASSWORD must be at least 16 letters and numbers, no symbols.
# Generate: openssl rand -hex 32
# Set this before the first start. Changing it later does not change the
# password already stored in the database volume.
POSTGRES_USER=vibecheck
POSTGRES_PASSWORD=replace-with-a-long-random-string
POSTGRES_DB=vibecheck

# --- HTTPS reverse proxy (Compose only) ---
# Bare hostname. No https:// and no path. Example: scan.example.com
SITE_ADDRESS=scan.example.com
# Let's Encrypt expiry notices go here. Not shown on the site.
ACME_EMAIL=you@example.com

# --- Email (web and worker) ---
# Magic links and monitoring alerts. Alerts are always stored in the dashboard.
# SMTP sends them when SMTP_HOST is set. Without it, production cannot sign anyone in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VibeCheck <scans@localhost>"

# --- Payments (web) ---
# dodo (default) or stripe. Plans, unlocks, and downloads stay the same either way.
PAYMENT_PROVIDER=dodo

# --- Dodo Payments (web) ---
# https://docs.dodopayments.com — create three products, then paste the IDs. Never commit secret keys.
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
# test_mode or live_mode. Keep test_mode until a real card should be charged.
DODO_ENV=test_mode
# Product IDs. Not secrets. Prices are tax-exclusive; tax is added at checkout.
# An empty value falls back to the ID on that line.
# $49 one-time full report
DODO_PRODUCT_REPORT=pdt_0NqUPK77rA0fd1CknGv8C
# $99 one-time full report + one rescan credit
DODO_PRODUCT_RESCAN=pdt_0NqUQCBmdARxCAyoaIRVZ
# $29/month continuous monitoring
DODO_PRODUCT_MONITOR=pdt_0NqUQeUgIBSIizoXIrkrJ

# --- Stripe (web) ---
# Create products/prices in the Stripe dashboard, then paste the price IDs. Never commit secret keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public browser key. It is visible to visitors. Never put a secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# $49 one-time full report
STRIPE_PRICE_REPORT=
# $99 one-time full report + one rescan credit
STRIPE_PRICE_RESCAN=
# $29/month continuous monitoring
STRIPE_PRICE_MONITOR=

# --- Signed-in checks (web and worker) ---
# 32-byte key, hex (64 chars) or standard base64. Required before a scan can store test-account passwords or tokens.
# Generate: openssl rand -hex 32
# Scans without test accounts still run if this is empty. Sending test accounts fails closed when it is missing.
# Production deploy refuses to start until this is set.
CREDENTIALS_ENCRYPTION_KEY=

# --- Browser and queue (worker, and the web process for PDF downloads) ---
# Worker. Set false to skip the rendered-page pass. PDF downloads on the web process still need the browser.
PLAYWRIGHT_ENABLED=true
# Web and worker. Use the system Chrome when Playwright's bundled browser is not installed: chrome
# Leave empty in Docker. The images install the bundled browser.
PLAYWRIGHT_CHANNEL=
# Worker. Hard stop for the headless render, in milliseconds. The scan continues with the fetched HTML if this is exceeded.
BROWSER_TIMEOUT_MS=20000
# Worker. Parallel scan jobs. Keep 1 on a small VM. Maximum 8.
WORKER_CONCURRENCY=1
# Web and worker. Public mailbox for /scanner-info and /contact. Set this before the site is public.
ABUSE_CONTACT_EMAIL=
# Web. Optional support mailbox for the contact page and legal pages. When empty, ABUSE_CONTACT_EMAIL is used.
SUPPORT_EMAIL=
# Web and worker. Checks in flight to one host at a time. Empty uses 2. Range 1–8.
# The worker waits for a free slot. It does not skip a check.
SCAN_TARGET_CONCURRENCY=2
# Web and worker. Milliseconds between starting requests to the same host. Empty uses 250. Range 0–5000.
SCAN_TARGET_MIN_INTERVAL_MS=250
# The Docker images set this to /ms-playwright. Leave it unset in .env.
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# --- Monitoring and badge (web and worker) ---
MONITOR_INTERVAL_HOURS=24
BADGE_STALE_DAYS=30

# --- Backups and Redis cap (Compose and scripts) ---
# How many days of pg_dump files to keep in ./backups.
BACKUP_RETENTION_DAYS=14
# Redis refuses new writes when this cap is hit, instead of deleting queued jobs.
REDIS_MAXMEMORY=64mb
