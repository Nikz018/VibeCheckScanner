# --- App ---
APP_URL=http://localhost:3000
# Public origin for canonical URLs, sitemap, robots, Open Graph, JSON-LD, and llms.txt.
# Set this before `next build` and `next start`. No trailing slash. Example: https://vibecheck.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string
# Show the magic link on the login screen when SMTP is not set. Keep false in production.
DEV_EXPOSE_MAGIC_LINK=true

# Allow scans of localhost / 127.0.0.1 (required for demo-targets). Keep false in production.
ALLOW_LOCAL_TARGETS=true
# Inside Docker, rewrite localhost to the host gateway so the web/worker containers can reach published demo ports.
# Leave empty when running npm scripts directly on the host.
LOCALHOST_REWRITE_HOST=

# --- Data ---
DATABASE_URL=postgresql://vibecheck:vibecheck@localhost:5432/vibecheck
REDIS_URL=redis://localhost:6379

# --- Email (optional) ---
# Monitoring alerts are always stored in the dashboard. SMTP sends them as email when set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VibeCheck <scans@localhost>"

# --- Stripe (test mode) ---
# Create products/prices in the Stripe dashboard, then paste the price IDs. Never commit secret keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# $49 one-time full report
STRIPE_PRICE_REPORT=
# $99 one-time full report + one rescan credit
STRIPE_PRICE_RESCAN=
# $29/month continuous monitoring
STRIPE_PRICE_MONITOR=

# --- Worker ---
PLAYWRIGHT_ENABLED=true
# Use the system Chrome when Playwright's bundled browser is not installed: chrome
PLAYWRIGHT_CHANNEL=
# Hard stop for the headless render, in milliseconds. The scan continues with the fetched HTML if this is exceeded.
BROWSER_TIMEOUT_MS=20000
MONITOR_INTERVAL_HOURS=24
BADGE_STALE_DAYS=30
