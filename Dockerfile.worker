# Production image for the BullMQ worker. linux/amd64 and linux/arm64.
# node:22-bookworm publishes both architectures. Do not pin a CPU here.
# Playwright installs the Chromium build that matches the image CPU, including
# linux/arm64. Do not install the Debian chromium package. It is a different build.
# PLAYWRIGHT_BROWSERS_PATH is set before the browser download so runtime finds it.

FROM node:22-bookworm
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci
RUN npx playwright install --with-deps chromium
COPY . .
ENV NODE_ENV=production \
    HOME=/home/vibecheck
RUN useradd --create-home --uid 1001 --shell /usr/sbin/nologin vibecheck \
    && mkdir -p /home/vibecheck/.npm \
    && chown -R vibecheck:vibecheck /app /home/vibecheck /ms-playwright
USER vibecheck
CMD ["sh", "scripts/worker-entrypoint.sh"]
