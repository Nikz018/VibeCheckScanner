generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  reportCredits    Int           @default(0)
  rescanCredits    Int           @default(0)
  stripeCustomerId String?
  createdAt        DateTime      @default(now())
  sessions         Session[]
  projects         Project[]
  scans            Scan[]
  purchases        Purchase[]
  subscription     Subscription?
  alerts           Alert[]
}

model MagicLink {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id                  String    @id @default(cuid())
  userId              String
  url                 String
  host                String
  ownershipToken      String
  ownershipMethod     String?
  ownershipVerifiedAt DateTime?
  monitorEnabled      Boolean   @default(false)
  createdAt           DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans               Scan[]

  @@unique([userId, url])
  @@index([userId])
}

model Scan {
  id             String    @id @default(cuid())
  projectId      String
  userId         String
  status         String    @default("queued")
  mode           String    @default("full")
  reportAccess   String    @default("teaser")
  targetUrl      String
  score          Int?
  passed         Boolean   @default(false)
  coverage       Json?
  severityCounts Json?
  error          String?
  consentAt      DateTime?
  consentText    String?
  shareEnabled   Boolean   @default(false)
  shareToken     String?   @unique
  scheduled      Boolean   @default(false)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  findings       Finding[]
  alerts         Alert[]

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model Finding {
  id           String @id @default(cuid())
  scanId       String
  checkId      String
  family       String
  severity     String
  title        String
  evidence     String
  impact       String
  fix          String
  headlineRank Int?
  sortOrder    Int    @default(100)
  raw          Json
  scan         Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
}

model Purchase {
  id                    String   @id @default(cuid())
  userId                String
  scanId                String?
  tier                  String
  stripeCheckoutSession String?  @unique
  stripePaymentIntent   String?
  status                String   @default("pending")
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeSubscriptionId String?   @unique
  stripeCustomerId     String?
  status               String    @default("inactive")
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Alert {
  id        String    @id @default(cuid())
  userId    String
  scanId    String
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scan      Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}
